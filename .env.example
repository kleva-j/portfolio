# Absolute production origin used for canonical and Open Graph URLs.
#
# Optional. Deployment platforms provide an origin automatically at runtime
# (Vercel: VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, Cloudflare Pages:
# CF_PAGES_URL, or a generic SITE_URL you set yourself). Set VITE_SITE_URL
# explicitly for a stable canonical across preview and production builds and
# for correct client-side navigation values — it is inlined at build time.
#
# Protocol is optional (https is assumed); a trailing slash is dropped.
VITE_SITE_URL=https://your-domain.com
